# PostgreSQL (recommended). For a zero-setup local run use: sqlite:///./german.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/german_ai
SECRET_KEY=replace-with-a-long-random-string
# --- AI provider (any OpenAI-compatible API) ---
# OPTION A: OpenAI (paid)  -> leave OPENAI_BASE_URL empty
# OPTION B: Groq (free tier, no credit card) -> uncomment the 5 lines below and paste your Groq key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_STT_MODEL=whisper-large-v3-turbo
# AI_TTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1
CORS_ORIGINS=http://localhost:5173
AI_RATE_LIMIT_PER_MINUTE=40
AI_MAX_TOKENS=700
AI_TIMEOUT_SECONDS=45
AUTO_CREATE_TABLES=true
